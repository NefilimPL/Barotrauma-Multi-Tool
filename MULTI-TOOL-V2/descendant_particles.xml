<?xml version="1.0" encoding="utf-8"?>
<Particles>
  <!-- Blue repair sparks: the native manager batches drawing and owns lifetime.
       This keeps the original 150/s emission, speed and gravity without Lua
       visiting and drawing every live spark on every rendered frame. -->
  <descendantrepairspark lifetime="0.3" lifetimemin="0.12"
    angularvelocitymin="0" angularvelocitymax="0" rotatetodirection="True"
    drag="0" waterdrag="0" velocitychange="0,-160" velocitychangewater="0,-160"
    usecollision="False" deleteoncollision="False"
    startsizemin="0.02,0.15" startsizemax="0.06,0.25" growtime="0"
    startcolor="220,248,255,255" endcolor="65,170,255,0"
    drawtarget="Both" drawontop="True" blendstate="Additive" priority="0">
    <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="392,83,106,16" />
  </descendantrepairspark>
  <!-- Native pulse-laser sprite and timing. Narrow only Y: uniformly scaling
       an emitter also shortens the ray-length X assigned by Particle.Init. -->
  <descendantpulsetracer lifetime="0.4" startdelaymin="0" startdelaymax="0"
    angularvelocitymin="0" angularvelocitymax="0" startrotationmin="0" startrotationmax="0"
    rotatetodirection="False" drag="0" waterdrag="0" velocitychange="0,0" velocitychangewater="0,0"
    collisionradius="1" usecollision="False" deleteoncollision="False" friction="0.5" restitution="0.5"
    startsizemin="1,0.11" startsizemax="1,0.11" growtime="0.02"
    startcolor="255,255,255,180" endcolor="255,255,255,0" drawtarget="Both" drawontop="True"
    blendstate="Additive" loopanim="False" lifetimemin="0"
    sizechangemin="0,-0.20" sizechangemax="0,-0.20" middlecolor="255,255,255,255"
    usemiddlecolor="False" animduration="1" priority="10">
    <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="144,440,1,68" origin="0.5,0.5" />
  </descendantpulsetracer>
  <descendantgaussmuzzle lifetime="0.14" animduration="0.14" loopanim="false"
    startsizemin="0.23,0.20" startsizemax="0.27,0.24" growtime="0"
    startcolor="255,240,212,255" endcolor="255,169,90,0"
    drawtarget="Both" drawontop="true" blendstate="Additive" priority="5">
    <animatedsprite texture="Content/Particles/MuzzleFlashParticleSheet.png"
      sourcerect="0,0,1024,384" columns="4" rows="3" origin="-0.1,0.6" premultiplyalpha="false" />
  </descendantgaussmuzzle>
  <descendantpulsemuzzle lifetime="0.12" startsizemin="0.30,0.30" startsizemax="0.43,0.43" growtime="0"
    startcolor="255,155,147,245" endcolor="255,65,65,0"
    drawtarget="Both" drawontop="true" blendstate="Additive" priority="5">
    <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="256,448,64,64" />
  </descendantpulsemuzzle>
</Particles>
